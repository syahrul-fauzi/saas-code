# =====================================================
# ENVIRONMENT CONFIGURATION
# =====================================================
NEXT_PUBLIC_ENV=development
GENERATE_SOURCEMAP=false

# =====================================================
# APPLICATION URLS
# =====================================================
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_DOCUMENTATION_URL=http://localhost:3010
NEXTAUTH_URL=http://localhost:3000

# =====================================================
# AUTHENTICATION SETTINGS
# =====================================================
AUTH_SECRET="dev-secret-should-be-random-and-long"
AUTH_TRUST_HOST=true

# Social Providers
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

AUTH_LINKEDIN_CLIENT_ID=
AUTH_LINKEDIN_CLIENT_SECRET=

AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# Notion OAuth (Optional)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# =====================================================
# OPENAI CONFIGURATION
# =====================================================
OPENAI_API_KEY=
OPENAI_ASSISTANT_ID=

# =====================================================
# PAYMENT PROVIDERS
# =====================================================
# Razorpay (India-based payment gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cashfree (Optional alternative)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# =====================================================
# EMAIL SERVICE (e.g., Resend)
# =====================================================
RESEND_API_KEY=

# =====================================================
# USER CREDENTIALS FOR DEVELOPMENT DEMO/SEED
# =====================================================
NEXT_PUBLIC_GUEST_MAIL=guest@example.com
NEXT_PUBLIC_GUEST_PASSWORD=guestpassword123

NEXT_PUBLIC_ADMIN_MAIL=admin@example.com
NEXT_PUBLIC_ADMIN_PASSWORD=adminpassword123

# =====================================================
# PUSHER CONFIGURATION
# =====================================================
PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_APP_KEY=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_APP_CLUSTER=

# =====================================================
# STORAGE / BLOB CONFIG
# =====================================================
BLOB_READ_WRITE_TOKEN=
