{
  "name": "turborepo-saas-boilerplate-code",
  "private": true,
  "scripts": {
    "# Development": "echo 'Development Scripts';",
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=nextjs-app",
    "dev:api": "turbo dev --filter=turborepo-saas-boilerplate-code-api",
    "dev:backend": "turbo dev --filter=backend",
    "dev:all": "concurrently \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:backend\"",
    "dev:electron": "cd apps/electron-app && npm run dev",
    "# Build": "echo 'Build Scripts';",
    "build": "turbo build",
    "build:web": "turbo build --filter=nextjs-app",
    "build:api": "turbo build --filter=hono-api",
    "build:backend": "turbo build --filter=backend",
    "build:all": "npm run build",
    "build:electron": "cd apps/electron-app && npm run build",
    "# Database": "echo 'Database Scripts';",
    "db:migrate": "cd packages/prisma-db && npm run postgres:migrate",
    "db:generate": "cd packages/prisma-db && npm run postgres:generate",
    "db:seed": "cd packages/prisma-db && npx prisma db seed",
    "db:studio": "cd packages/prisma-db && npx prisma studio --schema prisma/schema/schema.prisma",
    "db:reset": "cd packages/prisma-db && npx prisma migrate reset --schema prisma/schema/schema.prisma --force",
    "# Deployment": "echo 'Deployment Scripts';",
    "start": "turbo start",
    "start:nodejs-app": "cd apps/node-backend && npm run start",
    "start:web": "cd apps/nextjs-app && npm run start",
    "deploy:api": "cd apps/hono-api && npm run deploy",
    "# Testing & Quality": "echo 'Testing & Quality Scripts';",
    "test": "turbo test",
    "test:jest": "cd apps/nextjs-app && npm run test:jest",
    "test:coverage": "turbo test -- --coverage",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo check-types",
    "# Utility": "echo 'Utility Scripts';",
    "clean": "turbo clean && rm -rf node_modules",
    "clean:deps": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "clean:turbo": "find . -name '.turbo' -type d -prune -exec rm -rf '{}' +",
    "update:deps": "npx npm-check-updates -u && npm install",
    "postinstall": ""
  },
  "devDependencies": {
    "@repo/auth": "*",
    "@vitest/coverage-v8": "^3.1.4",
    "@vitest/ui": "^3.1.4",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "sonarqube-scanner": "^4.2.6",
    "turbo": "^2.3.3",
    "typescript": "5.5.4",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "packageManager": "npm@11.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@sparticuz/chromium": "^132.0.0",
    "cheerio": "^1.0.0",
    "dodopayments": "^0.19.0",
    "nextjs-toploader": "^3.7.15",
    "puppeteer-core": "^24.1.1",
    "react-dropzone": "^14.3.8",
    "swr": "^2.3.2"
  }
}
